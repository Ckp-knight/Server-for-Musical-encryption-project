{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Firestore": {
    "ProjectId": "musical-encryption-database"
  },
  "Jwt": {
    "Issuer": "musical-encryption-server",
    "Audience": "musical-encryption-client",
    "ExpiryMinutes": 30,
    "ClockSkewSeconds": 30
  },
  "AuthRateLimit": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  }
}
