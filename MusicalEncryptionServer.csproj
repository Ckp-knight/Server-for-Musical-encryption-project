<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets `dotnet user-secrets` store the local JWT signing key outside the repo. -->
    <UserSecretsId>7f6d3a1e-9b3c-4e02-8f1a-3c2d6a9b7e40</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Firestore" Version="4.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.14" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
  </ItemGroup>

  <!-- MusicalEncryptionServer.Tests lives in a subfolder; exclude it so its own
       build (xunit, Mvc.Testing, ...) isn't also compiled into this project. -->
  <ItemGroup>
    <Compile Remove="MusicalEncryptionServer.Tests\**" />
    <Content Remove="MusicalEncryptionServer.Tests\**" />
    <None Remove="MusicalEncryptionServer.Tests\**" />
  </ItemGroup>

</Project>
